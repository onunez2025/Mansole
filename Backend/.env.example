# Configuración de Base de Datos SQL Server (Local o Azure SQL Database)
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=YourStrong!Pass123
DB_NAME=CMMS_SOLE_DB
DB_ENCRYPT=false

# Seguridad JWT
# Generar uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Configuración de Servidor
PORT=5000
NODE_ENV=development

# Azure Blob Storage (Para fotos, manuales y evidencias)
AZURE_STORAGE_SAS_URL=https://soleblob1.blob.core.windows.net/produccion?sp=...
AZURE_STORAGE_CONTAINER_URL=https://soleblob1.blob.core.windows.net/produccion


# API Inteligencia Artificial para Diagnóstico de Fallas (Opcional - Gemini / OpenAI)
AI_API_KEY=your_api_key_here
AI_PROVIDER=gemini
